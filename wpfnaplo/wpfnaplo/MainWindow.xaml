<Window x:Class="wpfnaplo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:wpfnaplo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="5*"/>
        </Grid.RowDefinitions>

        <Label  Content="Neve:"/>
        <TextBox x:Name="nev" Grid.Column="1" VerticalAlignment="Center" Margin="10" Background="PeachPuff"/>


        <Label Content="Dátum:" Grid.Row="1"/>
        <DatePicker x:Name="datDatum" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="10" SelectedDate="2025.9.01"/>


        <Label Content="Tantárgy:" Grid.Row="2"/>
        <ComboBox x:Name="cbTantargy" Grid.Column="2" Grid.Row="2" VerticalAlignment="Center" Margin="10">
            <ComboBoxItem Content="Matematika" IsSelected="True"/>
            <ComboBoxItem Content="Magyar Irodalom"/>
            <ComboBoxItem Content="Fizika"/>
            <ComboBoxItem Content="Angol nyelv"/>
            <ComboBoxItem Content="Történelem"/>
        </ComboBox>

        <WrapPanel Grid.Row ="3">
            <Label Content="Jegy:" />
            <Label x:Name="jegy" Content="5" FontSize="20" Foreground="Red"/>
        </WrapPanel>
        <Slider x:Name="Slidjegy" Minimum="1" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Grid.Column="1" Grid.Row="3" VerticalAlignment="Center" Margin="10" Value="5" ValueChanged="slidJegy"/>

        <Button Content="Napló Betöltése" Grid.Row="4" Margin="8"/>
        <Button Content="Rögzít Napló" Grid.Column="1" Grid.Row="4" Margin="8" Click="naplobaRogzites"/>


        <ListBox x:Name="lbjegyek" Grid.Row="5" Grid.ColumnSpan="2" Background="Aqua" Margin="6"></ListBox>



    </Grid>
</Window>
